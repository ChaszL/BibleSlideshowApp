<Window x:Class="BibleSlideshow.PresenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresenterWindow" WindowStyle="None" 
        Background="Black" KeyDown="Window_KeyDown">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblText" Text="WELCOME" Foreground="White" FontSize="84" FontWeight="Bold" 
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1700" MaxHeight="700">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="15" Color="Black" ShadowDepth="4" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock x:Name="lblRef" Grid.Row="1" Text="" Foreground="#DDD" FontSize="34" FontWeight="SemiBold" 
                   TextAlignment="Center" Margin="0,35,0,0">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="3" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>