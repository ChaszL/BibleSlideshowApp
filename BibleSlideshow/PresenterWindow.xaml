<Window x:Class="BibleSlideshow.PresenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresenterWindow" WindowStyle="None"
        Background="Black" KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged">
    <Grid>
        <!-- Darkens the background image so white text stays readable on bright areas.
             Its opacity is set in code (only applied when a background image is loaded). -->
        <Rectangle x:Name="dimOverlay" Fill="Black" Opacity="0"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="lblText" Text="WELCOME" Foreground="White" FontSize="84" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" Color="Black" ShadowDepth="3" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="lblRef" Text="" Foreground="#FFE9A8" FontSize="38" FontWeight="Bold"
                       TextAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="16" Color="Black" ShadowDepth="3" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
