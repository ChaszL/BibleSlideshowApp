<Window x:Class="BibleSlideshow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SermonSlide Pro | Dashboard Controller" Height="700" Width="1000"
        Background="#F4F7F6" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RoundedCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FCFCFD"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="24,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="🎛️ SermonSlide Controller PRO" VerticalAlignment="Center" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <Button Content="❌ Close Presenter" Click="BtnClosePresenter_Click" DockPanel.Dock="Right" Background="#DC3545" Foreground="White" Padding="14,8" FontWeight="SemiBold" Margin="8,0,0,0" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🔁 Change Monitor" Click="BtnChangeMonitor_Click" DockPanel.Dock="Right" Background="#6C757D" Foreground="White" Padding="14,8" FontWeight="SemiBold" Margin="8,0,0,0" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Show Sermon Title" Click="BtnShowSermonTitle_Click" DockPanel.Dock="Right" Background="#FFC107" Foreground="#1F2937" Padding="14,8" FontWeight="SemiBold" Margin="8,0,0,0" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🟢 Open Presenter Window" Click="BtnOpenPresenter_Click" DockPanel.Dock="Right" Background="#2563EB" Foreground="White" Padding="14,8" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <Border Style="{StaticResource RoundedCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="1. LOAD BIBLE FILE" FontWeight="Bold" Foreground="#6B7280" FontSize="11"/>
                            <TextBlock x:Name="lblStatusWindow" Text="🔴 Live Window Offline" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Button Content="Load Bible File (.txt)" Click="BtnLoadBible_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedCard}">
                    <StackPanel>
                        <TextBlock Text="2. SERMON SUBJECT" FontWeight="Bold" Foreground="#6B7280" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtSubject" Text="Enter Sermon Title..." Margin="0,0,0,10"/>

                        <TextBlock Text="BACKGROUND IMAGE" FontWeight="Bold" Foreground="#6B7280" FontSize="11" Margin="0,0,0,6"/>
                        <Button Content="Upload Background Image" Click="BtnLoadBg_Click" Background="#10B981" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Button Content="Remove Background" Click="BtnClearBg_Click" Background="#F3F4F6" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedCard}">
                    <StackPanel>
                        <TextBlock Text="3. DIRECT VERSE JUMP" FontWeight="Bold" Foreground="#059669" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbBooks" Grid.Column="0" Margin="0,0,5,0" SelectionChanged="CmbBooks_SelectionChanged"/>
                            <TextBox x:Name="txtChap" Grid.Column="1" Margin="0,0,5,0" TextChanged="TxtChap_TextChanged" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtVerse" Grid.Column="2" TextChanged="TxtVerse_TextChanged" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedCard}">
                    <StackPanel>
                        <TextBlock Text="STAGE MONITOR PREVIEW" FontWeight="Bold" Foreground="#6B7280" FontSize="11" Margin="0,0,0,8"/>
                        <Border x:Name="pnlPreview" Background="#222" Height="120" CornerRadius="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="lblPreviewRef" Text="No Active Projection" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblPreviewText" Text="" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource RoundedCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="VERSE LIST" FontWeight="Bold" Foreground="#6B7280" FontSize="11"/>
                            <TextBlock x:Name="lblStatusFile" Text="Please upload file" HorizontalAlignment="Right" Foreground="Gray"/>
                        </DockPanel>
                        <ListBox x:Name="listVerses" Grid.Row="1" MouseDoubleClick="ListVerses_MouseDoubleClick" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="#F9FAFB" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullRef}" Foreground="#059669" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Text}" Foreground="#111827" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>